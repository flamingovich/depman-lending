generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                String  @id @default("default")
  siteName          String  @default("DepMan")
  siteTagline       String  @default("Партнёрские проекты")
  heroTitle         String  @default("⭐ Рейтинг лучших партнёров")
  searchPlaceholder String  @default("Поиск проекта")
  promoBannerText   String  @default("Войди и забери эксклюзивные бонусы")
  promoButtonText   String  @default("Войти")
  bottomBarTitle    String  @default("Справочник партнёра")
  bottomBarRating   Float   @default(5.0)
  bottomBarCtaText  String  @default("Открыть")
  telegramBotUrl    String?
  pinnedPartnerId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  logoLightUrl String?
  logoDarkUrl  String?
  bannerUrl   String?
  personImageUrl String?
  cardScreenshotUrl String?
  featuredCoinImageUrl String?
  badge       String?
  rating      Float    @default(5.0)
  accentColor String   @default("#b8ff3c")
  features    String   @default("[]")
  affiliateUrl String?
  royalCampaignId      String?
  affiliateUrlSyncedAt DateTime?
  affiliateUrlSource   String?
  promoCode   String?
  bonus1Label String?
  bonus1Value String?
  bonus2Label String?
  bonus2Value String?
  cardLayout        String   @default("grid")
  inTopStrip        Boolean  @default(false)
  inBestBlock       Boolean  @default(false)
  topSortOrder      Int      @default(0)
  bestSortOrder     Int      @default(0)
  ctaText     String   @default("Перейти")
  kind        String   @default("casino")
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  bonuses     Bonus[]
  reviews     Review[]
  viewerWins  ViewerWin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ViewerWin {
  id                  String   @id @default(cuid())
  screenshotUrl       String
  cropX               Float    @default(0)
  cropY               Float    @default(0)
  cropWidth           Float    @default(1)
  cropHeight          Float    @default(0.5625)
  partnerId           String
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  telegramUserId      String
  telegramUsername    String?
  telegramDisplayName String?
  telegramPhotoUrl    String?
  winAmount           String?
  winMultiplier       String?
  slotName            String?
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  isBigWin            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  authorName String   @default("Гость")
  rating     Int
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bonus {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  value       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
